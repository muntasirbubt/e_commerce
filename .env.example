# Local development PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/modular_commerce?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Gateway disabled means fallback checkout methods are used.
ENABLE_PAYMENT_GATEWAY="false"
ACTIVE_PAYMENT_PROVIDERS="cod,bank_transfer,order_request"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

STORE_NAME="Modular Market"
STORE_CURRENCY="USD"
STORE_TIMEZONE="Asia/Dhaka"
SUPPORT_EMAIL="support@example.com"
SUPPORT_PHONE=""
STORE_ADDRESS=""
SHIPPING_FEE="0"
LOW_STOCK_THRESHOLD="5"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-before-seeding"

# Uploads are local for development; Cloudinary is available for production.
STORAGE_DRIVER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
