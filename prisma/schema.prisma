generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id           String          @id @default(cuid())
  name         String?
  email        String          @unique
  passwordHash String
  role         Role            @default(CUSTOMER)
  orders       Order[]
  reviews      ProductReview[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id                  String               @id @default(cuid())
  title               String
  slug                String               @unique
  description         String               @default("")
  imageUrl            String?
  media               ProductMedia[]
  isUpcoming          Boolean              @default(false)
  launchAt            DateTime?
  seoTitle            String?
  seoDescription      String?
  specifications      Json                 @default("{}")
  categoryId          String?
  category            Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isPublished         Boolean              @default(false)
  variants            ProductVariant[]
  reviews             ProductReview[]
  notifySubscriptions NotifySubscription[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([isPublished, createdAt])
}

model ProductVariant {
  id             String         @id @default(cuid())
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String         @unique
  price          Decimal        @db.Decimal(12, 2)
  salePrice      Decimal?       @db.Decimal(12, 2)
  stockQuantity  Int            @default(0)
  attributesJson Json           @default("{}")
  orderItems     OrderItem[]
  inventoryLogs  InventoryLog[]

  @@index([productId])
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  userId           String?
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName     String
  customerEmail    String
  totalAmount      Decimal       @db.Decimal(12, 2)
  shippingAmount   Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(12, 2)
  couponId         String?
  coupon           Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode       String?
  status           OrderStatus   @default(PENDING)
  paymentMethod    String
  paymentStatus    PaymentStatus @default(UNPAID)
  paymentReference String?       @unique
  shippingAddress  Json
  items            OrderItem[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([createdAt, status])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  price     Decimal        @db.Decimal(12, 2)
}

model InventoryLog {
  id             String         @id @default(cuid())
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  changeQuantity Int
  reason         String
  createdAt      DateTime       @default(now())

  @@index([variantId, createdAt])
}

model StoreSettings {
  id                     Int      @id @default(1)
  gatewayEnabled         Boolean  @default(false)
  activePaymentProviders String[] @default(["cod", "bank_transfer", "order_request"])
  shippingFee            Decimal  @default(0) @db.Decimal(12, 2)
  lowStockThreshold      Int      @default(5)
  storeName              String   @default("Modular Market")
  currency               String   @default("USD")
  supportEmail           String   @default("")
  supportPhone           String   @default("")
  storeAddress           String   @default("")
  updatedAt              DateTime @updatedAt
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([productId, position])
  @@index([productId, position])
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  body      String
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId, createdAt])
}

model NotifySubscription {
  id        String   @id @default(cuid())
  email     String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([email, productId])
  @@index([productId])
}

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  discountType    DiscountType
  amount          Decimal      @db.Decimal(12, 2)
  startsAt        DateTime?
  endsAt          DateTime?
  maxRedemptions  Int?
  redemptionCount Int          @default(0)
  active          Boolean      @default(true)
  orders          Order[]
  createdAt       DateTime     @default(now())

  @@index([active, startsAt, endsAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
